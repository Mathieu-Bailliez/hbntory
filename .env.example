# Copier ce fichier en .env, puis remplir les valeurs vides.
# Ne jamais commiter le fichier .env.

# ============================================================
# Base de données (PostgreSQL)
# ============================================================

# Mot de passe de la base, au choix : lettres et chiffres uniquement, sans espaces ni caractères spéciaux
POSTGRES_PASSWORD=

# Utilisateur de la base : le nom du projet, à garder tel quel
POSTGRES_USER=hbntory

# Base de données partagée par tout le projet (Backoffice, serveur MCP…), à garder tel quel
POSTGRES_DB=hbntory_db

# URL de connexion utilisée par le Backoffice, à garder telle quelle.
# "localhost" : fonctionne depuis votre machine (hors Docker).
# Depuis un autre conteneur du projet, l'hôte devient "bdd" (nom du service).
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# ============================================================
# Comptes créés au démarrage (seed.py)
# ============================================================

# Mot de passe de l'admin
ADMIN_PASSWORD=

# Mot de passe de l'employé de démonstration
DEMO_USER_PASSWORD=

# ============================================================
# Backoffice : signature des cookies de session (Flask)
# ============================================================

# Clé secrète longue et aléatoire, à générer avec :
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Ne jamais la partager : elle permet de fabriquer de faux cookies de connexion.
SECRET_KEY=

# ============================================================
# Serveur MCP : compte PostgreSQL en lecture seule
# ============================================================

# Mot de passe du compte mcp_readonly (lecture de branches et stock uniquement), au choix : lettres et chiffres uniquement
MCP_DB_PASSWORD=

# URL de connexion du serveur MCP, à garder telle quelle.
# "localhost" : fonctionne depuis votre machine (hors Docker).
# Depuis un autre conteneur du projet, l'hôte devient "bdd" (nom du service).
MCP_DATABASE_URL=postgresql://mcp_readonly:${MCP_DB_PASSWORD}@localhost:5432/${POSTGRES_DB}
